# Footballytics Environment Variables
# ====================================
# Copy this file to .env.local and fill in your values

# =============================================================================
# REQUIRED: Authentication (Clerk)
# =============================================================================
# Get your keys at: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# =============================================================================
# OPTIONAL: Caching (Upstash Redis)
# =============================================================================
# Get your credentials at: https://console.upstash.com
# Free tier: 10,000 commands/day
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# OPTIONAL: Database (Neon PostgreSQL)
# =============================================================================
# Get your connection string at: https://console.neon.tech
# Free tier: 0.5GB storage, 3GB data transfer
DATABASE_URL=

# =============================================================================
# OPTIONAL: Football Data APIs
# =============================================================================
# Football-Data.org (Free tier: 10 requests/minute)
# Get your key at: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# RapidAPI (API-Football) - Free tier: 100 requests/day
# Get your key at: https://rapidapi.com/api-sports/api/api-football
RAPIDAPI_KEY=

# =============================================================================
# OPTIONAL: AI Services
# =============================================================================
# OpenAI - For advanced AI insights
OPENAI_API_KEY=

# Anthropic Claude - For multi-agent system
ANTHROPIC_API_KEY=

# =============================================================================
# ANALYTICS & MONITORING (Optional)
# =============================================================================
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
SENTRY_DSN=

# =============================================================================
# APP CONFIGURATION
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Footballytics Environment Variables
# ====================================
# Copy this file to .env.local and fill in your values

# =============================================================================
# OPTIONAL: Caching (Upstash Redis)
# =============================================================================
# Get your credentials at: https://console.upstash.com
UPSTASH_REDIS_REST_URL=your_upstash_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# =============================================================================
# OPTIONAL: Database (Neon PostgreSQL)
# =============================================================================
# Get your connection string at: https://console.neon.tech
DATABASE_URL=your_database_url_here

# =============================================================================
# OPTIONAL: Football Data APIs
# =============================================================================
# Football-Data.org (Free tier: 10 requests/minute)
FOOTBALL_DATA_API_KEY=your_football_data_key_here

# RapidAPI (API-Football)
RAPIDAPI_KEY=your_rapidapi_key_here

# =============================================================================
# OPTIONAL: AI Services
# =============================================================================
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# =============================================================================
# APP CONFIGURATION
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
